# Azure OpenAI (primary backend)
# You can use EITHER Format A (LiteLLM-native) OR Format B (alias format).

# Format A: LiteLLM-native Azure vars
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_BASE=https://your-endpoint.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# Format B: Alias vars (supported by app/llm.py and mapped automatically)
MODEL=gpt-5.2
AZURE_ENDPOINT=https://your-endpoint.openai.azure.com
# Optional canonical name (same value as AZURE_ENDPOINT)
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
AZURE_DEPLOYMENT=gpt-5.2
API_VERSION=2024-12-01-preview
API_KEY=your-azure-openai-key


# GitHub (for repo search + optional issue creation)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPOSITORY=ThirtyNimrod/post-for-me-please
